# Copy this file to .env for local Docker Compose use.
MYSQL_USER=activity
MYSQL_PASSWORD=replace-with-a-local-password
MYSQL_ROOT_PASSWORD=replace-with-a-local-root-password
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRATION=PT2H
# 二维码默认访问地址；也可由管理者在二维码页面直接设置
# 局域网测试填 http://电脑局域网IP:5173，正式环境填 HTTPS 域名
VITE_PUBLIC_APP_URL=
AI_ENABLED=false
AI_BASE_URL=https://api.deepseek.com
AI_API_KEY=
AI_MODEL=deepseek-chat
AI_CONNECT_TIMEOUT=PT5S
AI_READ_TIMEOUT=PT30S
AI_MAX_TOKENS=1200
AI_REQUESTS_PER_MINUTE=5
