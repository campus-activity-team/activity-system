# Copy this file to .env for local Docker Compose use.
MYSQL_USER=activity
MYSQL_PASSWORD=replace-with-a-local-password
MYSQL_ROOT_PASSWORD=replace-with-a-local-root-password
JWT_SECRET=replace-with-at-least-32-random-characters
# 本地/局域网演示保持登录 30 天；正式环境建议缩短并使用 HTTPS
JWT_EXPIRATION=P30D
# CORS 来源白名单；局域网测试保留默认值，正式环境改为 https://你的域名
APP_CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:*,http://127.0.0.1:*,http://192.168.*:*,http://10.*:*,http://172.*:*
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=系统管理员
# 二维码默认访问地址；也可由管理者在二维码页面直接设置
# 局域网测试填 http://电脑局域网IP:5173，正式环境填 HTTPS 域名
VITE_PUBLIC_APP_URL=
AI_ENABLED=false
AI_BASE_URL=https://api.deepseek.com
AI_API_KEY=
AI_MODEL=deepseek-chat
AI_CONNECT_TIMEOUT=PT5S
AI_READ_TIMEOUT=PT30S
AI_MAX_TOKENS=1200
AI_REQUESTS_PER_MINUTE=5
